    function t(cle, a, b) {
        var d = Reglages.langue === "en" ? en : fr
        var s = d[cle]
        if (s === undefined) s = fr[cle]
        if (s === undefined) return cle
        if (a !== undefined) s = s.replace("%1", a)
        if (b !== undefined) s = s.replace("%2", b)
        return s
    }

    function missions(n) {
        return t(n <= 1 ? "score.mission" : "score.missions", n)
    }
